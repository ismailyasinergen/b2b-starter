# Medusa B2B backend
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# Put long-lived/test tokens in the process environment, never in MCP prompts.
# Customer bearer token used by /store/companies, /store/quotes and /store/approvals.
MEDUSA_STORE_TOKEN=
# Admin bearer token used by /admin/companies and /admin/quotes.
MEDUSA_ADMIN_TOKEN=

# Mutations are fail-closed unless explicitly enabled.
MCP_ALLOW_WRITES=false
MEDUSA_REQUEST_TIMEOUT_MS=20000

# HTTP transport
MCP_HOST=127.0.0.1
MCP_PORT=3333
MCP_CORS_ORIGIN=*
